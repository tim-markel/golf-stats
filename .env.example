# Google Gemini API key (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Tavily web search API key (free tier) — https://app.tavily.com
TAVILY_API_KEY=

# PostgreSQL connection string for the golf-stats database
DATABASE_URL=postgresql://localhost:5432/golf_stats

# Optional overrides
GEMINI_MODEL=gemini-2.5-flash

# Email delivery (welcome + password-reset). Leave EMAIL_PROVIDER unset for dev
# mode (emails are logged to dev_emails.log). To send real email via Resend:
#   EMAIL_PROVIDER=resend
#   RESEND_API_KEY=re_...            # https://resend.com/api-keys
#   EMAIL_FROM=onboarding@resend.dev # or a verified domain address
# Where reset links point (used in emails):
# FRONTEND_URL=http://localhost:3000
